# Copy to `.env.local` (gitignored) and fill in. NEVER commit real values, and
# never paste them into a chat/transcript.
#
#   cp .env.example .env.local && $EDITOR .env.local
#   set -a && . ./.env.local && set +a          # load into your shell
#
# Use a THROWAWAY account: the fault-injection tests deliberately interrupt
# sends and kill the process mid-operation.
#
# Use an APP-SPECIFIC PASSWORD, never your account password — scoped, revocable,
# and the only thing Gmail/iCloud accept for IMAP anyway:
#   Gmail:  myaccount.google.com → Security → 2-Step Verification → App passwords
#   iCloud: account.apple.com → Sign-In and Security → App-Specific Passwords
# Revoke it when you're done testing.

PETREL_IMAP_HOST=imap.gmail.com
PETREL_IMAP_PORT=993
PETREL_IMAP_USER=you@example.com
# Quote it. Gmail shows app passwords as four space-separated groups, and an
# unquoted value makes the shell try to run "xxxx" as a command. The spaces are
# cosmetic — Google accepts it with or without them.
PETREL_IMAP_PASS='xxxxxxxxxxxxxxxx'
