    { "query": "re:pricing", "reads": ["text:re:pricing"], "cut": null },
    { "query": "is:whatever", "reads": ["text:is:whatever"], "cut": null },
    { "query": "after:soon", "reads": ["text:after:soon"], "cut": null },
    { "query": "after:1969", "reads": ["text:after:1969"], "cut": null },
    { "query": "date:2026-02-30", "reads": ["text:date:2026-02-30"], "cut": null },
    { "query": "date:2028-02-29", "reads": ["date:2028-02-29"], "cut": null },
    { "query": "\"from:sam\"", "reads": ["text:from:sam"], "cut": null },
