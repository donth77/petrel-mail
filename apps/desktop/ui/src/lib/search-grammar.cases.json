{
  "note": "What the engine makes of a query, and what the field has to predict. Read by search-grammar.test.ts on this side and by apps/desktop/src-tauri/tests/search_field.rs on the engine's, so that neither can drift without the other noticing. `reads` is one entry per term the engine keeps, in the order it reads them, written as `[-]key:value` with `text` for words the index searches. `cut` is what the field says under the results when a query is too long. Canonical forms only: each side's own tests cover the spellings the engine accepts for the same thing.",
  "cases": [
    { "query": "annex", "reads": ["text:annex"], "cut": null },
    { "query": "annex pricing", "reads": ["text:annex", "text:pricing"], "cut": null },
    { "query": "\"board pack\"", "reads": ["text:board pack"], "cut": null },
    { "query": "  spaced   out  ", "reads": ["text:spaced", "text:out"], "cut": null },
    { "query": "-draft", "reads": ["-text:draft"], "cut": null },
    { "query": "--draft", "reads": ["-text:draft"], "cut": null },
    { "query": "e-mail", "reads": ["text:e-mail"], "cut": null },
    { "query": "-", "reads": ["text:-"], "cut": null },
    { "query": "from:sam", "reads": ["from:sam"], "cut": null },
    { "query": "FROM:Sam", "reads": ["from:Sam"], "cut": null },
    { "query": "from:\"Dana Wu\" contract", "reads": ["from:Dana Wu", "text:contract"], "cut": null },
    { "query": "-from:sam", "reads": ["-from:sam"], "cut": null },
