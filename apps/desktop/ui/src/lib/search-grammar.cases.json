  "long": {
    "note": "Built rather than written out: `value` is the character repeated `times`, put after `prefix`.",
    "cases": [
      { "prefix": "", "value": "x", "times": 256, "cut": null },
      { "prefix": "", "value": "x", "times": 257, "cut": "value" },
