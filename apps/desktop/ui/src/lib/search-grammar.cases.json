    { "query": "subject:invoice", "reads": ["subject:invoice"], "cut": null },
    { "query": "in:Sent", "reads": ["in:sent"], "cut": null },
    { "query": "tag:urgent filename:.pdf", "reads": ["tag:urgent", "filename:.pdf"], "cut": null },
    { "query": "is:unread has:attachment", "reads": ["is:unread", "has:attachment"], "cut": null },
    { "query": "after:2026-06-01 before:2027", "reads": ["after:2026-06-01", "before:2027"], "cut": null },
