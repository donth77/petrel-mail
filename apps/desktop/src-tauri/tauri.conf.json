{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petrel",
  "version": "1.0.0",
  "identifier": "dev.petrel.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; frame-src petrel-msg: http://petrel-msg.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A fast, local-first desktop email client.",
    "longDescription": "Petrel talks straight to your mail server over IMAP and SMTP. Your mail stays on your own machine, in SQLite and ordinary files.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRUE4NURGQTg0NUVFMApSV1RnWG9UNlhhanVCejEvVUlRdCtiNjNGd0RLVjdabndJSXdTakN1ekhnWkpWZ3pIWUgwNEw1dwo=",
      "endpoints": [
        "https://github.com/donth77/petrel-mail/releases/latest/download/latest.json"
      ]
    }
  }
}
